---
import '@fontsource/big-shoulders-display/latin-700';
import '@fontsource/big-shoulders-display/latin-900';
import '@fontsource/chakra-petch/latin-400';
import '@fontsource/chakra-petch/latin-500';
import '@fontsource/chakra-petch/latin-600';
import '@fontsource/chakra-petch/latin-700';
import '@fontsource/share-tech-mono/latin-400';
import '../styles/global.css';
import { flags, site, contact, hud, hero, figures, mission, contracts, loadout, footer } from '../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const resumeHref = base + contact.resume;
const ogImage = new URL('og.png', site.url).href;

// Turn **bold** segments into <strong>
const bold = (s: string) =>
  s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#070707" />
    <link rel="canonical" href={site.url} />
    <link rel="icon" href={base + 'favicon.svg'} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={site.url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip" href="#mission">Skip to content</a>
    {flags.showScanlines && <div class="scanlines" aria-hidden="true"></div>}

    <div class="top">
      <div class="wrap">
        <nav class="hud" aria-label="Primary">
          <div class="hud__left">
            <span class="hud__tag">{hud.tag}</span>
            <span class="hud__status">{hud.status}</span>
          </div>
          <ul class="hud__links">
            {hud.nav.map((l) => (
              <li><a href={l.href} class={l.accent ? 'glitch accent' : 'glitch'}>{l.label}<span class="glitch__layer" aria-hidden="true">{l.label}</span></a></li>
            ))}
          </ul>
        </nav>

        <header class="hero">
          <div class="hero__main">
            <p class="hero__kicker" style="margin:0">{hero.kicker}<span class="cursor" aria-hidden="true"></span></p>
            <h1 class="hero__name">
              <span class="hero__first">{hero.firstName}</span>
              <span class="hero__last">{hero.lastName}</span>
            </h1>
            <p class="hero__tagline">{hero.taglineBefore}<mark>{hero.taglineHighlight}</mark>{hero.taglineAfter}</p>
            <div class="btns">
              <a class="btn btn--primary glitch" href={`mailto:${contact.email}`}>Email me ▸<span class="glitch__layer" aria-hidden="true">Email me ▸</span></a>
              <a class="btn glitch" href={resumeHref}>Résumé.pdf<span class="glitch__layer" aria-hidden="true">Résumé.pdf</span></a>
              <a class="btn glitch" href={contact.linkedin} rel="me noopener">LinkedIn<span class="glitch__layer" aria-hidden="true">LinkedIn</span></a>
            </div>
          </div>

          <aside class="idcard" aria-label="Operator ID">
            <div class="idcard__inner">
              <div class="idcard__head"><span>{hero.idCard.id}</span><span>{hero.idCard.badge}</span></div>
              <dl>
                {hero.idCard.rows.map(([k, v]) => (
                  <div><dt>{k}</dt><dd>{v}</dd></div>
                ))}
              </dl>
            </div>
          </aside>
        </header>
      </div>
    </div>

    {flags.showFigures && (
      <div class="figures">
        <dl class="wrap" aria-label="Key figures">
          {figures.map((f, i) => (
            <div data-reveal style={`--i:${i}`}><dt>{f.label}</dt><dd data-count>{f.value}</dd></div>
          ))}
        </dl>
      </div>
    )}

    <main class="wrap">
      <section id="mission" class="section mission" aria-labelledby="mission-label">
        <div class="mission__meta" data-reveal="wipe">
          <h2 id="mission-label" class="section-label">{mission.label}</h2>
          <span>{mission.meta}</span>
        </div>

        <div class="mission__intro">
          <span class="mission__op" data-reveal="wipe">{mission.op}</span>
          <h3 class="mission__headline" data-reveal>{mission.headline} <span class="red">{mission.headlineAccent}</span></h3>
          <p class="mission__lead" data-reveal style="--i:1">{mission.lead}</p>
        </div>

        <div class="boxes">
          {mission.boxes.map((b, i) => (
            <div class="box" data-reveal style={`--i:${i}`}><h4>{b.title}</h4><p>{b.body}</p></div>
          ))}
        </div>

        <dl class="results" data-reveal>
          {mission.results.map((r) => (
            <div><dt>{r.label}</dt><dd class={r.accent ? 'red' : undefined} data-count>{r.value}</dd></div>
          ))}
        </dl>
      </section>

      <section id="contracts" class="section" aria-labelledby="contracts-label">
        <h2 id="contracts-label" class="section-label" data-reveal="wipe">{contracts.label}</h2>
        <div class="roles">
          {contracts.roles.map((r, i) => (
            <article class="role" data-reveal={i % 2 ? 'right' : 'left'} style={`--i:${i % 2}`}>
              <div class="role__inner">
                <div class="role__meta"><span class="red">{r.company}</span><span>{r.years}</span></div>
                <h3>{r.title}</h3>
                <p>{r.summary}</p>
                <ul>{r.bullets.map((b) => <li><span>{b}</span></li>)}</ul>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="loadout" class="section" aria-labelledby="loadout-label">
        <h2 id="loadout-label" class="section-label" data-reveal="wipe">{loadout.label}</h2>
        <div class="loadout">
          <div class="stack">
            {loadout.stack.map((s, i) => (
              <div class="stack__row" data-reveal="left" style={`--i:${i}`}>
                <h3 class="stack__cat">{s.category}</h3>
                <ul class={s.highlight ? 'chips chips--hot' : 'chips'}>
                  {s.items.map((it) => <li>{it}</li>)}
                </ul>
              </div>
            ))}
          </div>

          <div class="side">
            <ul class="edu">
              {loadout.education.map((e, i) => (
                <li data-reveal="right" style={`--i:${i}`}><h3>{e.title}</h3><span>{e.detail}</span></li>
              ))}
            </ul>
            {flags.showProjects && (
              <div class="sideops" data-reveal="right" style="--i:1">
                <h3>{loadout.sideOps.label}</h3>
                <p set:html={bold(loadout.sideOps.text)} />
              </div>
            )}
          </div>
        </div>
      </section>

      <footer id="contact" class="contact">
        <span class="contact__label" data-reveal="wipe">{footer.label}</span>
        <h2 class="contact__headline" data-reveal>{footer.headline} <span class="red">{footer.headlineAccent}</span></h2>
        <ul class="contact__links">
          <li data-reveal style="--i:0"><a class="glitch" href={`mailto:${contact.email}`}>{contact.email}<span class="glitch__layer" aria-hidden="true">{contact.email}</span></a></li>
          <li data-reveal style="--i:1"><a class="glitch" href={contact.linkedin} rel="me noopener">{contact.linkedinLabel}<span class="glitch__layer" aria-hidden="true">{contact.linkedinLabel}</span></a></li>
          <li data-reveal style="--i:2"><a class="glitch" href={resumeHref}>Résumé.pdf<span class="glitch__layer" aria-hidden="true">Résumé.pdf</span></a></li>
        </ul>
        <div class="contact__bar" data-reveal="wipe">
          <span>{footer.copyright}</span>
          <span class="red">{footer.eof}</span>
        </div>
      </footer>
    </main>

    <script is:inline>
      (() => {
        const els = document.querySelectorAll('[data-reveal]');
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const count = (el) => {
          const m = el.textContent.match(/^(\d+)(.*)$/s);
          if (!m || still || /^[–-]/.test(m[2])) return;
          const end = +m[1], rest = m[2], t0 = performance.now(), dur = 900;
          const tick = (t) => {
            const k = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - k, 3);
            el.textContent = Math.round(end * e) + rest;
            if (k < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        const show = (el) => { el.classList.add('in'); el.querySelectorAll('[data-count]').forEach(count); };
        if (still || !('IntersectionObserver' in window)) { els.forEach((el) => el.classList.add('in')); return; }
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { show(e.target); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -40px 0px', threshold: 0.12 });
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
